{
  "RateLimits": {
    "RequestsPerMinute": 600,
    "AuthPerMinute": 10
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/identity/{action:regex(^(login|register)$)}"
        }
      },
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity/{**rest}"
        }
      },
      "identity-openapi": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/openapi/identity.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "catalog": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/catalog/{**rest}"
        }
      },
      "catalog-openapi": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/openapi/catalog.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "basket": {
        "ClusterId": "basket",
        "Match": {
          "Path": "/api/basket/{**rest}"
        },
        "AuthorizationPolicy": "default"
      },
      "basket-openapi": {
        "ClusterId": "basket",
        "Match": {
          "Path": "/openapi/basket.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "inventory": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/inventory/{**rest}"
        }
      },
      "inventory-openapi": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/openapi/inventory.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "ordering": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/ordering/{**rest}"
        },
        "AuthorizationPolicy": "default"
      },
      "ordering-openapi": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/openapi/ordering.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "payment": {
        "ClusterId": "payment",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/payment/{**rest}"
        }
      },
      "payment-openapi": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/openapi/payment.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "basket": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5103"
          }
        }
      },
      "inventory": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5104"
          }
        }
      },
      "ordering": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5105"
          }
        }
      },
      "payment": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5106"
          }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Service} {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
