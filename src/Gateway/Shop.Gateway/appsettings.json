{
  "RateLimits": {
    "RequestsPerMinute": 600,
    "AuthPerMinute": 10
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/identity/{action:regex(^(login|register)$)}" }
      },
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/{**rest}" }
      },
      "identity-openapi": {
        "ClusterId": "identity",
        "Match": { "Path": "/openapi/identity.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/{**rest}" }
      },
      "catalog-openapi": {
        "ClusterId": "catalog",
        "Match": { "Path": "/openapi/catalog.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "primary": { "Address": "http://localhost:5101" } }
      },
      "catalog": {
        "Destinations": { "primary": { "Address": "http://localhost:5102" } }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Service} {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
